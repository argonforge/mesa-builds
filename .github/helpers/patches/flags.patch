--- a/debian/rules
+++ b/debian/rules
@@ -198,6 +198,15 @@
	$(confflags_VALGRIND) \
	$(confflags_TEFLON)

+confflags += -Dc_args="$(OPT_FLAGS)" -Dcpp_args="$(OPT_FLAGS)"
