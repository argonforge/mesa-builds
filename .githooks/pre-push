#!/bin/bash

download_bash_helpers() {
	printf "Installing bash-helpers\n"
	[[ -d /usr/local/lib/bash/includes ]] || {
		sudo mkdir -p /usr/local/lib/bash/includes || return 1
	}

	sudo curl -so /usr/local/lib/bash/includes/bash-helpers.sh \
		https://raw.githubusercontent.com/nafigator/bash-helpers/master/src/bash-helpers.sh || return 1
	sudo chmod +x /usr/local/lib/bash/includes/bash-helpers.sh || return 1

	return 0
}

init_bash_helpers() {
	[[ -e /usr/local/lib/bash/includes/bash-helpers.sh ]] || download_bash_helpers || return 1

	if [[ ! -x /usr/local/lib/bash/includes/bash-helpers.sh ]]; then
		printf "Insufficient permissions for bash-helpers execute\n"; return 1
	fi

	. /usr/local/lib/bash/includes/bash-helpers.sh

	return 0
}

init_bash_helpers || exit 1

# shellcheck disable=SC2034
INTERACTIVE=1

check_dependencies typos || exit 1

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
CONFIG="$REPO_ROOT/.typos.toml"
FLAGS=( -c "$CONFIG" "$REPO_ROOT" )
PIPE_FLAGS=( -c "$CONFIG" "-" )

[[ -f "$CONFIG" ]] || {
	error "Typos config not found"
	exit 1
}

# check project typos
typos "${FLAGS[@]}"
status 'Project typos' $? || exit 1

# commit typos check
result=0
while read -r local_ref local_sha remote_ref remote_sha; do
	# branch delete
	[[ "$local_sha" =~ ^0+$ ]] && continue

	if [[ "$remote_sha" =~ ^0+$ ]]; then
		range=( "$local_sha" --not --remotes="$1" )
	else
		range=( "$remote_sha..$local_sha" )
	fi

	while IFS= read -r message; do
		[[ -z "$message" ]] && continue

		if ! printf "%s\n" "$message" | typos "${PIPE_FLAGS[@]}" ; then
			error "Typos in commit message: '$message'"
			result=1
		fi
	done < <(git log "${range[@]}" --pretty=format:%B%n)
done

[[ $result -eq 0 ]] && status "Commit typos" OK

exit $result
